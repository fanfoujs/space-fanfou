{
  "name": "space-fanfou",
  "description": "Cross-browser Fanfou extension for Chrome, Firefox, and Safari",
  "contributors": [
    "Kevin Deng <dksnow2002@gmail.com> (https://fanfou.com/anegie)",
    "Riophae Lee <riophaelee@gmail.com> (https://fanfou.com/ruif)",
    "LitoMore <litomore@gmail.com> (https://fanfou.com/lito)",
    "Xidorn Quan <me@upsuper.org> (https://fanfou.com/xidorn)",
    "Rex Zhang <rex.zhasm@gmail.com> (https://fanfou.com/zhasm)"
  ],
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:safari": "wxt build -b safari --mv3",
    "build:all": "npm run build && npm run build:firefox && npm run build:safari",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "unit": "vitest run",
    "unit:dev": "vitest",
    "test": "npm run typecheck && npm run lint && npm run unit",
    "test:e2e": "playwright test tests/playwright/migration.spec.ts",
    "pack": "wxt zip --mv3",
    "pack:firefox": "wxt zip -b firefox --mv3",
    "pack:safari": "wxt zip -b safari --mv3",
    "release": "npm test && npm run build:all && npm run verify:build && npm run pack && npm run pack:firefox && npm run pack:safari",
    "safari:project": "node scripts/package-safari.mjs",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3 --no-config-discovery",
    "test:firefox": "node scripts/test-firefox.mjs",
    "format": "prettier --write wxt.config.ts vitest.config.ts tsconfig.json eslint.config.mjs scripts tests/unit src/platform src/entrypoints src/features/registry.ts",
    "verify:build": "node scripts/verify-build.mjs"
  },
  "license": "GPL v3",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "activity-detector": "^3.0.0",
    "array-last": "^1.3.0",
    "array-move": "^2.1.0",
    "casey-js": "^1.6.2",
    "classnames": "^2.2.6",
    "compat-trigger-event": "^1.0.0",
    "crypto-js": "^4.2.0",
    "defined": "^1.0.0",
    "delegated-events": "^1.0.10",
    "dom-chef": "^3.6.0",
    "dom-element-is-natively-editable": "^1.0.4",
    "dompurify": "^3.3.0",
    "dot-prop": "^8.0.0",
    "easings-css": "^1.0.0",
    "element-ready": "^4.1.0",
    "element-visible": "^1.0.2",
    "fast-deep-equal": "^3.1.1",
    "is-number": "^7.0.0",
    "is-promise": "^2.1.0",
    "is-visible": "^2.2.0",
    "js-cookie": "^2.2.0",
    "just-clamp": "^3.1.0",
    "just-debounce-it": "^1.1.0",
    "just-flush": "^1.1.0",
    "just-map-values": "^1.2.1",
    "just-once": "^1.1.0",
    "just-pick": "^2.1.0",
    "just-remove": "^2.1.0",
    "many-keys-map": "^1.0.2",
    "material-colors": "^1.2.6",
    "oauth-1.0a": "^2.2.6",
    "object-to-formdata": "^2.1.2",
    "p-retry": "^4.1.0",
    "p-sleep": "^1.1.0",
    "pify": "^4.0.1",
    "preact": "^10.0.0",
    "prop-types": "^15.7.2",
    "react-sortable-hoc": "^1.8.3",
    "react-tooltip-lite": "^1.9.1",
    "safe-json-parse": "^4.0.0",
    "select-dom": "^6.0.0",
    "semver": "^7.1.1",
    "split-lines": "^2.0.0",
    "string-width": "^4.1.0",
    "tinydate": "^1.0.1",
    "transform-url": "^1.0.1",
    "tributejs": "^4.0.0",
    "wretch": "^1.5.1",
    "htmlparser2": "^10.0.0",
    "css-select": "^5.2.2",
    "domutils": "^3.2.2",
    "domhandler": "^5.0.3"
  },
  "devDependencies": {
    "wxt": "^0.21.5",
    "vite": "^7.3.0",
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0",
    "@playwright/test": "^1.58.2",
    "vitest": "^4.1.0",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.0.0",
    "globals": "^16.0.0",
    "less": "^4.0.0",
    "autoprefixer": "^10.0.0",
    "@babel/core": "^7.28.0",
    "@webext-core/fake-browser": "^2.0.1",
    "web-ext": "^9.2.0",
    "prettier": "^3.0.0"
  },
  "type": "module",
  "version": "2.0.0"
}
