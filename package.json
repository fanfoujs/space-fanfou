{
	"name": "space-fanfou",
	"version": "2.1.1",
	"private": true,
	"description": "Cross-browser Fanfou extension for Chrome, Firefox, and Safari",
	"license": "GPL v3",
	"contributors": [
		"Kevin Deng <dksnow2002@gmail.com> (https://fanfou.com/anegie)",
		"Riophae Lee <riophaelee@gmail.com> (https://fanfou.com/ruif)",
		"LitoMore <litomore@gmail.com> (https://fanfou.com/lito)",
		"Xidorn Quan <me@upsuper.org> (https://fanfou.com/xidorn)",
		"Rex Zhang <rex.zhasm@gmail.com> (https://fanfou.com/zhasm)"
	],
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox --mv3",
		"build": "wxt build --mv3",
		"build:beta": "node scripts/build-beta.mjs build",
		"build:firefox": "wxt build -b firefox --mv3",
		"build:safari": "wxt build -b safari --mv3",
		"build:all": "npm run build && npm run build:firefox && npm run build:safari",
		"postinstall": "wxt prepare",
		"typecheck": "tsc --noEmit",
		"lint": "xo",
		"pack": "wxt zip --mv3",
		"pack:beta": "node scripts/build-beta.mjs zip",
		"pack:firefox": "wxt zip -b firefox --mv3",
		"pack:safari": "wxt zip -b safari --mv3",
		"pack:all": "npm run pack && npm run pack:firefox && npm run pack:safari",
		"release": "npm run typecheck && npm run lint && npm run build:all && npm run verify:build && npm run pack:all",
		"safari:project": "node scripts/package-safari.mjs",
		"lint:firefox": "web-ext lint --source-dir .output/firefox-mv3 --no-config-discovery",
		"format": "xo --fix",
		"verify:build": "node scripts/verify-build.mjs",
		"verify:build:beta": "node scripts/verify-build.mjs --beta"
	},
	"dependencies": {
		"activity-detector": "^3.0.0",
		"array-last": "^1.3.0",
		"array-move": "^2.1.0",
		"casey-js": "^1.6.2",
		"classnames": "^2.2.6",
		"compat-trigger-event": "^1.0.0",
		"crypto-js": "^4.2.0",
		"css-select": "^5.2.2",
		"defined": "^1.0.0",
		"delegated-events": "^1.0.10",
		"dom-chef": "^3.6.0",
		"dom-element-is-natively-editable": "^1.0.4",
		"domhandler": "^5.0.3",
		"dompurify": "^3.3.0",
		"domutils": "^3.2.2",
		"dot-prop": "^8.0.0",
		"easings-css": "^1.0.0",
		"element-ready": "^4.1.0",
		"element-visible": "^1.0.2",
		"fanfou-sdk": "7.0.0-beta.3",
		"fast-deep-equal": "^3.1.1",
		"htmlparser2": "^10.0.0",
		"is-number": "^7.0.0",
		"is-promise": "^2.1.0",
		"is-visible": "^2.2.0",
		"js-cookie": "^3.0.7",
		"just-clamp": "^3.1.0",
		"just-debounce-it": "^1.1.0",
		"just-flush": "^1.1.0",
		"just-map-values": "^1.2.1",
		"just-once": "^1.1.0",
		"just-pick": "^2.1.0",
		"just-remove": "^2.1.0",
		"many-keys-map": "^1.0.2",
		"material-colors": "^1.2.6",
		"oauth-1.0a": "^2.2.6",
		"object-to-formdata": "^2.1.2",
		"p-retry": "^4.1.0",
		"p-sleep": "^1.1.0",
		"pify": "^4.0.1",
		"preact": "^10.0.0",
		"prop-types": "^15.7.2",
		"react": "npm:@preact/compat@^16.9.0",
		"react-dom": "npm:@preact/compat@^16.9.0",
		"react-sortable-hoc": "^1.8.3",
		"react-tooltip-lite": "^1.9.1",
		"safe-json-parse": "^4.0.0",
		"select-dom": "^6.0.0",
		"semver": "^7.1.1",
		"split-lines": "^2.0.0",
		"string-width": "^4.1.0",
		"tinydate": "^1.0.1",
		"transform-url": "^1.0.1",
		"tributejs": "^4.0.0",
		"wretch": "^1.5.1"
	},
	"devDependencies": {
		"@babel/core": "^7.28.0",
		"@preact/preset-vite": "^2.10.6",
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/node": "^26.6.6",
		"autoprefixer": "^10.0.0",
		"globals": "^16.0.0",
		"less": "^4.0.0",
		"typescript": "^6.0.3",
		"vite": "^7.3.0",
		"web-ext": "^10.8.0",
		"wxt": "^0.21.5",
		"xo": "^5.0.1"
	}
}
